# CompanyOps backend configuration (copy to .env)

# Execution mode: demo (deterministic fixture) | openai (real GPT, falls back to fixture on error)
EXECUTION_MODE=demo

# OpenAI (only used when EXECUTION_MODE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Database (SQLite file)
DB_PATH=./data/companyops.db

# Backups (periodic SQLite file copy)
BACKUP_DIR=./backups

# Git output target (used by the GitInterface unit; U1 uses a local stub)
GIT_REMOTE=https://github.com/DDthonWinner/TestOutput
CHECKOUT_ROOT=./checkouts
GIT_SUBPROCESS_TIMEOUT_SECONDS=120

# QA: optional real test command run in the project checkout; empty => labeled demo PASS
QA_TEST_CMD=

# Server
HOST=127.0.0.1
PORT=8000
